---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Mahesh Arivelayuthm — AI Full Stack Engineer">
  <main class="home">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-eyebrow">Scottsdale, AZ · Open to AI Full Stack roles</div>
      <h1 class="hero-name">Mahesh<br/>Arivelayuthm</h1>
      <div class="hero-roles">
        <span class="role">Frontend Engineer</span>
        <span class="sep">/</span>
        <span class="role">AI Agent Builder</span>
        <span class="sep">/</span>
        <span class="role">16 Years</span>
      </div>
      <p class="hero-bio">
        16 years of frontend engineering — now building AI agents,
        RAG pipelines, and agentic applications.
        Learning in public, one agent at a time.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn-primary">Read the blog →</a>
        <a href="mailto:a.mahesh8589@gmail.com" class="btn-secondary">Get in touch</a>
      </div>
    </section>

    <!-- Projects -->
    <section class="projects">
      <div class="section-header">
        <div class="eyebrow">Projects</div>
        <a href="https://github.com/aadeshmahesh" target="_blank" class="see-all">GitHub →</a>
      </div>

      <!-- Project 1 — Calendar Agent -->
      <div class="project-card">
        <div class="project-top">
          <div>
            <span class="project-badge badge-ai">AI Agent · Project 1</span>
            <div class="project-title">📅 Calendar Scheduling Agent</div>
            <p class="project-desc">
              Agentic loop that schedules meetings from natural language.
              Provider-agnostic — works with Ollama locally or Anthropic Claude
              in production. Switch with one environment variable.
            </p>
            <div class="project-tags">
              <span class="ptag">Agentic Loop</span>
              <span class="ptag">Tool Use</span>
              <span class="ptag">Node.js</span>
              <span class="ptag">React</span>
              <span class="ptag">Anthropic</span>
            </div>
          </div>
          <a href="https://github.com/aadeshmahesh/calendar-agent" target="_blank" class="project-link">View →</a>
        </div>
        <div class="concept-box">
          <div class="concept-label">New Concept</div>
          <div class="concept-text">
            The agentic loop — <code>while(stop_reason === "tool_use")</code>.
            LLM decides which tool to call. Your code executes it.
            Results feed back. Loop continues until goal is reached.
          </div>
        </div>
      </div>

      <!-- Project 2 — IT Support Agent -->
      <div class="project-card">
        <div class="project-top">
          <div>
            <span class="project-badge badge-ai">RAG + Agent · Project 2</span>
            <div class="project-title">🛠️ IT Support Agent</div>
            <p class="project-desc">
              Diagnoses and fixes VPN and internal tool access issues.
              Searches company knowledge base before acting — RAG without
              a vector DB. Parallel tool calls check VPN and Jira simultaneously.
            </p>
            <div class="project-tags">
              <span class="ptag">RAG</span>
              <span class="ptag">Parallel Tools</span>
              <span class="ptag">Node.js</span>
              <span class="ptag">React</span>
              <span class="ptag">Anthropic</span>
            </div>
          </div>
          <a href="https://github.com/aadeshmahesh/it-support-agent" target="_blank" class="project-link">View →</a>
        </div>
        <div class="concept-box">
          <div class="concept-label">New Concept</div>
          <div class="concept-text">
            RAG with JSON keyword search — no vector DB needed for small doc sets.
            Parallel tool calls: LLM checks VPN + Jira access in the same turn.
            System prompt as agent behaviour controller.
          </div>
        </div>
      </div>

      <!-- Project 3 — Site Search Agent (detailed) -->
      <div class="project-card project-featured">
        <div class="project-top">
          <div>
            <span class="project-badge badge-live">● Live · Project 3</span>
            <div class="project-title">🔍 Site Search Agent</div>
            <p class="project-desc">
              AI-powered semantic product search that solves the vocabulary mismatch
              problem — "footwear for jogging" finds running shoes even though those
              words don't appear in any product name. Built with Voyage AI embeddings,
              Neon pgvector, and Anthropic Claude.
            </p>
            <div class="project-tags">
              <span class="ptag">Real Embeddings</span>
              <span class="ptag">pgvector</span>
              <span class="ptag">Voyage AI</span>
              <span class="ptag">Cosine Similarity</span>
              <span class="ptag">Neon Postgres</span>
              <span class="ptag">Anthropic</span>
              <span class="ptag">Node.js</span>
              <span class="ptag">React</span>
            </div>
          </div>
          <a href="https://github.com/aadeshmahesh/site-search-agent" target="_blank" class="project-link">View →</a>
        </div>

        <!-- How it works -->
        <div class="concept-box">
          <div class="concept-label">New Concept — Real RAG Pipeline</div>
          <div class="concept-text">
            Two-phase pipeline: <strong>indexing</strong> (product text → Voyage AI → 512-dimensional
            vector → stored in pgvector) and <strong>querying</strong> (user query → same Voyage AI model →
            vector → cosine similarity search → ranked results → Claude generates response).
            Must use the same embedding model for both phases.
          </div>
        </div>

        <!-- Two column detail section -->
        <div class="detail-grid">

          <!-- Trade-offs -->
          <div class="detail-box">
            <div class="detail-title">⚖️ Trade-offs</div>
            <table class="tradeoff-table">
              <thead>
                <tr>
                  <th>Approach</th>
                  <th>Pros</th>
                  <th>Cons</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>JSON keyword</strong><br/><span class="badge-sm">Project 2</span></td>
                  <td>Zero setup · Free · Fast</td>
                  <td>Vocabulary mismatch · No semantic understanding</td>
                </tr>
                <tr>
                  <td><strong>Postgres FTS</strong></td>
                  <td>Built-in · Good ranking · Handles typos</td>
                  <td>Still keyword-based · Misses synonyms</td>
                </tr>
                <tr>
                  <td><strong>pgvector + embeddings</strong><br/><span class="badge-sm">Project 3</span></td>
                  <td>Semantic understanding · Handles any phrasing</td>
                  <td>API cost · Needs seeding · Slower setup</td>
                </tr>
                <tr>
                  <td><strong>Hybrid search</strong></td>
                  <td>Best of both · Production standard</td>
                  <td>Most complex · Higher cost</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- PII / Sensitive Data -->
          <div class="detail-box">
            <div class="detail-title">🔒 Handling Sensitive Data</div>
            <div class="sensitivity-grid">
              <div class="sensitivity-row safe">
                <div class="sensitivity-label">✅ Safe to send to Voyage AI</div>
                <div class="sensitivity-items">
                  Product catalogs · Blog posts · Public docs · IT policy docs
                </div>
              </div>
              <div class="sensitivity-row caution">
                <div class="sensitivity-label">⚠️ Use private cloud (Azure OpenAI / AWS Bedrock)</div>
                <div class="sensitivity-items">
                  Employee records · Internal strategies · Financial data · PII
                </div>
              </div>
              <div class="sensitivity-row danger">
                <div class="sensitivity-label">🔴 Self-hosted only (air-gapped)</div>
                <div class="sensitivity-items">
                  Medical records (HIPAA) · Legal documents · Government / classified data
                </div>
              </div>
              <div class="sensitivity-note">
                Production pattern: mask PII before embedding →
                store mapping separately → embed anonymised text only.
              </div>
            </div>
          </div>

        </div>

        <!-- Vocabulary mismatch proof -->
        <div class="vocab-box">
          <div class="detail-title">🧪 Vocabulary Mismatch — Proved</div>
          <div class="vocab-grid">
            <div class="vocab-col">
              <div class="vocab-label bad">❌ Keyword search</div>
              <div class="vocab-query">"footwear for jogging"</div>
              <div class="vocab-result">Looks for: "footwear" "jogging"<br/>Found in products: NONE<br/>Result: empty</div>
            </div>
            <div class="vocab-arrow">→</div>
            <div class="vocab-col">
              <div class="vocab-label good">✅ Vector search (this project)</div>
              <div class="vocab-query">"footwear for jogging"</div>
              <div class="vocab-result">
                Nike Air Zoom · similarity: 0.89<br/>
                Brooks Ghost · similarity: 0.86<br/>
                Hoka Clifton · similarity: 0.84
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Project 4 — Autism Worksheet Studio -->
      <div class="project-card">
        <div class="project-top">
          <div>
            <span class="project-badge badge-live">● Live</span>
            <div class="project-title">🧩 Autism Worksheet Studio</div>
            <p class="project-desc">
              Free AI-powered tool generating PECS cards, visual schedules,
              and social stories for autism families. Built as a parent who needed it.
              Open source. Features agentic AI content pipeline, ARASAAC pictograms,
              and 3-layer rate limiting.
            </p>
            <div class="project-tags">
              <span class="ptag">React 19</span>
              <span class="ptag">Hono</span>
              <span class="ptag">Cloudflare Workers</span>
              <span class="ptag">Anthropic Claude</span>
              <span class="ptag">Neon Postgres</span>
              <span class="ptag">Drizzle ORM</span>
              <span class="ptag">AGPL-3.0</span>
            </div>
          </div>
          <a href="https://github.com/aadeshmahesh/autism-worksheet-studio" target="_blank" class="project-link">View →</a>
        </div>
      </div>

      <!-- Project 5 — TimeTrack -->
      <div class="project-card">
        <div class="project-top">
          <div>
            <span class="project-badge badge-build">Built</span>
            <div class="project-title">⏱️ TimeTrack</div>
            <p class="project-desc">
              Enterprise-grade time tracking SaaS. Django 5 + DRF backend,
              React 18 + Redux Toolkit + TanStack Query frontend with
              Recharts dashboards. 5-phase architecture.
            </p>
            <div class="project-tags">
              <span class="ptag">Django</span>
              <span class="ptag">React 18</span>
              <span class="ptag">Redux Toolkit</span>
              <span class="ptag">TanStack Query</span>
              <span class="ptag">MySQL</span>
            </div>
          </div>
          <a href="https://github.com/aadeshmahesh/timetrack" target="_blank" class="project-link">View →</a>
        </div>
      </div>

    </section>


    <!-- AI Concepts -->
    <section class="concepts">
      <div class="section-header">
        <div class="eyebrow">Core Concepts</div>
        <a href="/blog" class="see-all">Read the blog →</a>
      </div>

      <div class="concepts-intro">
        <p>
          These 5 concepts are the foundation of every AI agent I build.
          Understanding how they relate to each other is what separates
          engineers who use AI from engineers who build AI systems.
        </p>
      </div>

      <!-- Visual Diagram -->
      <div class="diagram-box">
        <div class="diagram-title">// How the layers fit together</div>
        <div class="diagram-body">

          <!-- Agent wraps everything -->
          <div class="diagram-agent">
            <div class="diagram-agent-label">🤖 AGENT — encapsulates everything below</div>

            <div class="diagram-inner">

              <!-- Model -->
              <div class="diagram-model">
                <div class="diagram-block block-model">
                  🧠 MODEL (claude-sonnet-4-6)
                  <div class="diagram-block-sub">reasons · decides · generates</div>
                </div>
              </div>

              <!-- MCP Bridge -->
              <div class="diagram-arrow-down">↓ MCP Protocol (the bridge)</div>

              <!-- Tools + Knowledge side by side -->
              <div class="diagram-bottom">
                <div class="diagram-block block-tool">
                  🔧 TOOLS
                  <div class="diagram-block-sub">search · enable · schedule</div>
                  <div class="diagram-block-sub">your code executes these</div>
                </div>
                <div class="diagram-block block-knowledge">
                  📚 KNOWLEDGE
                  <div class="diagram-block-sub">RAG · pgvector · Neon DB</div>
                  <div class="diagram-block-sub">retrieved before LLM acts</div>
                </div>
              </div>

            </div>
          </div>

          <!-- Project mapping -->
          <div class="diagram-projects">
            <div class="diagram-projects-title">Your projects use this pattern:</div>
            <div class="diagram-projects-grid">
              <div class="diagram-project">
                <span class="dp-badge">P1</span>
                <span class="dp-name">Calendar Agent</span>
                <span class="dp-concepts">Model + Tools (no knowledge)</span>
              </div>
              <div class="diagram-project">
                <span class="dp-badge">P2</span>
                <span class="dp-name">IT Support Agent</span>
                <span class="dp-concepts">Model + Tools + Knowledge (JSON RAG)</span>
              </div>
              <div class="diagram-project">
                <span class="dp-badge">P3</span>
                <span class="dp-name">Site Search Agent</span>
                <span class="dp-concepts">Model + Tools + Knowledge (pgvector)</span>
              </div>
              <div class="diagram-project">
                <span class="dp-badge dp-badge-upcoming">P4</span>
                <span class="dp-name">Restaurant Agent</span>
                <span class="dp-concepts">Model + MCP + Tools + Knowledge + Memory</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- 5 concept cards -->
      <div class="concepts-grid">

        <div class="concept-card">
          <div class="concept-icon">🤖</div>
          <div class="concept-name">Agent</div>
          <div class="concept-one-line">Encapsulates Model + Tools + Knowledge + Loop</div>
          <div class="concept-detail">
            The whole system. Agent is the container that holds everything together —
            the model reasons inside it, tools execute through it,
            knowledge is retrieved by it, the loop runs inside it.
            System prompt defines its personality and rules.
          </div>
          <div class="concept-example">while(stop_reason === "tool_use") — the core loop</div>
          <div class="concept-user-example">
            <div class="cue-label">User says</div>
            <div class="cue-text">"My VPN is not working and I can't access Jira"</div>
            <div class="cue-label">Agent orchestrates</div>
            <div class="cue-text">RAG → check VPN → fix VPN → check Jira → fix Jira → confirm ✅</div>
          </div>
        </div>

        <div class="concept-card">
          <div class="concept-icon">🧠</div>
          <div class="concept-name">Model</div>
          <div class="concept-one-line">The brain — reasons and decides (lives inside Agent)</div>
          <div class="concept-detail">
            The LLM itself. Lives inside the agent.
            Cannot act on the world alone — no memory, no internet, no tools.
            The agent gives it tools and knowledge to work with.
          </div>
          <div class="concept-example">claude-sonnet-4-6 · llama3.1 · gpt-4o</div>
          <div class="concept-user-example">
            <div class="cue-label">User says</div>
            <div class="cue-text">"Schedule a standup tomorrow at 10am"</div>
            <div class="cue-label">Model reasons</div>
            <div class="cue-text">"I should check availability first, then book the slot"</div>
          </div>
        </div>

        <div class="concept-card">
          <div class="concept-icon">🔧</div>
          <div class="concept-name">Tool</div>
          <div class="concept-one-line">The hands — executes real world actions</div>
          <div class="concept-detail">
            Functions YOUR code defines that the model can request.
            LLM never calls tools directly — it says "call this",
            your code executes it, returns result back to LLM.
            MCP standardizes how tools are exposed.
          </div>
          <div class="concept-example">search_products · enable_vpn · schedule_event</div>
          <div class="concept-user-example">
            <div class="cue-label">Model requests</div>
            <div class="cue-text">check_availability("2026-07-26", "10:00", "10:30")</div>
            <div class="cue-label">Your code returns</div>
            <div class="cue-text">&#123; available: true, slot: "10:00–10:30" &#125;</div>
          </div>
        </div>

        <div class="concept-card">
          <div class="concept-icon">📚</div>
          <div class="concept-name">Knowledge</div>
          <div class="concept-one-line">The memory — information retrieved before acting</div>
          <div class="concept-detail">
            External information retrieved before the LLM acts.
            Prevents hallucination. Grounds responses in real data.
            JSON keyword (P2) → pgvector embeddings (P3) → user memory (P4).
          </div>
          <div class="concept-example">RAG · pgvector · Voyage AI · embeddings</div>
          <div class="concept-user-example">
            <div class="cue-label">User searches</div>
            <div class="cue-text">"footwear for jogging"</div>
            <div class="cue-label">Knowledge retrieves</div>
            <div class="cue-text">Nike Air Zoom (0.94) · Brooks Ghost (0.91) · Hoka Clifton (0.90)</div>
          </div>
        </div>

        <div class="concept-card concept-card-featured">
          <div class="concept-icon">🔌</div>
          <div class="concept-name">MCP</div>
          <div class="concept-one-line">The bridge — standard protocol between agent and tools</div>
          <div class="concept-detail">
            Model Context Protocol — Anthropic standard for connecting LLMs
            to tools and knowledge. Like USB-C for AI. Write tools once in
            an MCP server — any agent connects via URL. Claude Desktop,
            Cursor, and your own agents all speak MCP. Used in Project 4.
          </div>
          <div class="concept-example">mcp_servers: [&#123; url: "http://localhost:3010/sse" &#125;]</div>
          <div class="concept-user-example">
            <div class="cue-label">Without MCP</div>
            <div class="cue-text">executeTool() written in every app — duplicated everywhere</div>
            <div class="cue-label">With MCP (Project 4)</div>
            <div class="cue-text">One MCP server → Claude Desktop + your agent + any AI connects ✅</div>
          </div>
        </div>

      </div>

      <!-- Flow diagram -->
      <div class="concepts-flow">
        <div class="flow-title">// Request flow — what happens when user types</div>
        <div class="flow-steps">
          <div class="flow-step">
            <div class="flow-step-icon">👤</div>
            <div class="flow-step-label">User Input</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">🤖</div>
            <div class="flow-step-label">Agent receives</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">🧠</div>
            <div class="flow-step-label">Model reasons</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">🔌</div>
            <div class="flow-step-label">MCP bridge</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">🔧</div>
            <div class="flow-step-label">Tool executes</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">📚</div>
            <div class="flow-step-label">Knowledge retrieved</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">🔁</div>
            <div class="flow-step-label">Loop repeats</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-step-icon">✅</div>
            <div class="flow-step-label">Result to user</div>
          </div>
        </div>
      </div>

    </section>

    <!-- Recent posts -->
    <section class="recent">
      <div class="recent-header">
        <div class="eyebrow">Latest writing</div>
        <a href="/blog" class="see-all">See all posts →</a>
      </div>
      <div class="recent-posts">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="recent-card">
            <div class="recent-date">
              {new Date(post.data.date).toLocaleDateString('en-US', {
                month: 'short', day: 'numeric'
              })}
            </div>
            <div class="recent-title">{post.data.title}</div>
            <div class="recent-desc">{post.data.description}</div>
            <div class="recent-tags">
              {post.data.tags.slice(0,3).map(t => <span class="tag">#{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>

  </main>
</Base>

<style>
  .home { max-width: 1100px; margin: 0 auto; padding: 0 48px; }

  /* ── Hero ── */
  .hero {
    min-height: 70vh; display: flex; flex-direction: column;
    justify-content: center; padding: 80px 0 64px;
  }
  .hero-eyebrow {
    font-family: var(--mono); font-size: 12px; color: var(--muted);
    margin-bottom: 24px; display: flex; align-items: center; gap: 10px;
  }
  .hero-eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--muted); display: inline-block; }
  .hero-name {
    font-family: var(--display); font-size: clamp(48px, 7vw, 80px);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0; margin-bottom: 20px;
  }
  .hero-roles {
    font-family: var(--display); font-size: clamp(16px, 2.5vw, 24px);
    font-weight: 600; color: var(--ink2); margin-bottom: 32px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  }
  .sep { color: var(--rule); }
  .hero-bio { font-size: 17px; color: var(--ink2); max-width: 520px; line-height: 1.75; margin-bottom: 40px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary {
    padding: 12px 24px; background: var(--indigo); color: white;
    border-radius: 8px; font-size: 14px; font-weight: 600;
    text-decoration: none; transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.88; }
  .btn-secondary {
    padding: 12px 24px; border: 1px solid var(--rule); color: var(--ink);
    border-radius: 8px; font-size: 14px; font-weight: 500;
    text-decoration: none; transition: border-color 0.15s;
  }
  .btn-secondary:hover { border-color: var(--ink); }

  /* ── Projects ── */
  .projects { padding: 64px 0; border-top: 1px solid var(--rule); }
  .section-header {
    display: flex; justify-content: space-between;
    align-items: baseline; margin-bottom: 24px;
  }
  .eyebrow {
    font-family: var(--mono); font-size: 11px; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .see-all { font-family: var(--mono); font-size: 12px; color: var(--indigo); text-decoration: none; }

  /* ── Project Card ── */
  .project-card {
    background: white; border: 1px solid var(--rule);
    border-radius: 14px; padding: 28px;
    margin-bottom: 20px;
    transition: border-color 0.2s;
  }
  .project-card:hover { border-color: #c7d2fe; }
  .project-featured { border-color: var(--indigo); }
  .project-featured:hover { border-color: var(--indigo); box-shadow: 0 4px 24px rgba(79,70,229,0.08); }

  .project-top {
    display: flex; justify-content: space-between;
    align-items: flex-start; gap: 20px; margin-bottom: 16px;
  }
  .project-link {
    font-family: var(--mono); font-size: 13px; color: var(--indigo);
    text-decoration: none; white-space: nowrap; padding: 6px 14px;
    border: 1px solid var(--indigo); border-radius: 6px;
    transition: background 0.15s, color 0.15s; flex-shrink: 0;
  }
  .project-link:hover { background: var(--indigo); color: white; }

  .project-badge {
    display: inline-flex; font-family: var(--mono); font-size: 10px;
